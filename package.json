{
  "name": "nxus-core",
  "version": "5.0.0",
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    }
  },
  "description": "A framework for building light-weight, event-driven data processing apps.",
  "bin": {
    "gonxus": "./bin/start.js"
  },
  "scripts": {
    "preversion": "npm test",
    "postversion": "npm run docs:build && git push && git push --tags",
    "test": "npm run build && NODE_ENV=test nxus_myconfig=test mocha -R spec test/lib/* --config=./test/testApp/.nxusrc",
    "clean": "rm -rf dist",
    "build": "node ./scripts/build.js",
    "prepublishOnly": "npm run build",
    "docs:api": "typedoc --plugin typedoc-plugin-markdown --out docs/api src/index.ts",
    "docs:site:dev": "vitepress dev docs",
    "docs:site:build": "vitepress build docs",
    "docs:build": "npm run docs:api && npm run docs:site:build"
  },
  "author": "info@nxusapp.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nxus/core.git"
  },
  "bugs": {
    "url": "https://github.com/nxus/core/issues"
  },
  "homepage": "https://github.com/nxus/core",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "async": "^2.0.1",
    "chokidar": "^4.0.0",
    "deep-extend": "^0.4.1",
    "merge-descriptors": "^1.0.1",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "morph": "^0.2.0",
    "multimatch": "^2.1.0",
    "rc": "^1.1.6",
    "stack-trace": "0.0.9",
    "underscore": "^1.8.3",
    "underscore.deep": "^0.5.1",
    "winston": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "chai": "^3.5.0",
    "chai-as-promised": "^5.3.0",
    "mocha": "^3.0.2",
    "should": "^11.1.0",
    "sinon": "^1.17.5",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.4.0",
    "typescript": "^5.8.0",
    "vitepress": "^1.6.0"
  }
}
